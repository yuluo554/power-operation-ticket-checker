{
  "description": "M0/M2 骨架演示规则：7 票种基础通路（required_field + time_order，applies_to 门控），验证引擎通路与 M2 解析回归；正式规则库（process_signature/ticket_type_match/measure_coverage/five_prevention/consistency 及许可区间扩展）随 M3 知识库入库。工作票/抢修单的签字链字段（签发人/许可人）不列入 required_field——缺环归 process_signature 语义，避免归因双计。",
  "rules": [
    {
      "id": "R-OP-001",
      "name": "操作票必填项完整性",
      "check_type": "required_field",
      "applies_to": ["operating"],
      "basis": {
        "standard": "Q/GDW 1799.1-2013",
        "clause": "附录 倒闸操作票格式（字段清单重构）",
        "status": "待核对"
      },
      "level": "形式合规",
      "risk": "低",
      "suggestion": "补全缺失的必填字段后重新提交审核。",
      "params": {
        "fields": ["ticket_no", "task", "start_time", "end_time", "dispatcher", "guardian", "operator"]
      }
    },
    {
      "id": "R-OP-002",
      "name": "操作时间顺序合法",
      "check_type": "time_order",
      "applies_to": ["operating"],
      "basis": {
        "standard": "Q/GDW 1799.1-2013",
        "clause": "操作票填写要求（时间先后逻辑）",
        "status": "待核对"
      },
      "level": "形式合规",
      "risk": "一般",
      "suggestion": "核对操作开始/结束时间填写是否颠倒。",
      "params": {
        "start": "start_time",
        "end": "end_time"
      }
